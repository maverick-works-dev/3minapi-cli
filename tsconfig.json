{
	// For the editor and type checking. During development, Node 24 type stripping runs the source (node src/bin.ts).
	// The published build is JS in dist/ from tsconfig.build.json — Node refuses to run .ts files inside node_modules.
	"compilerOptions": {
		"target": "es2024",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"strict": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["src", "test"]
}
